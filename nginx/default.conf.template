server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy the secret Google Calendar iCal feed so the URL never reaches the browser
    location = /calendar.ics {
        proxy_pass ${CALENDAR_ICS_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host calendar.google.com;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        add_header Cache-Control "no-store";
    }

    # Read-only proxy to Syssla; the token is added here and never reaches the browser
    location = /syssla/api/lists {
        limit_except GET { deny all; }
        proxy_pass https://syssla.felixarvidsson.se/api/lists;
        proxy_ssl_server_name on;
        proxy_set_header Host syssla.felixarvidsson.se;
        proxy_set_header Authorization "Bearer ${SYSSLA_TOKEN}";
        proxy_set_header Cookie "";
        add_header Cache-Control "no-store";
    }

    location = /syssla/api/tasks {
        limit_except GET { deny all; }
        proxy_pass https://syssla.felixarvidsson.se/api/tasks;
        proxy_ssl_server_name on;
        proxy_set_header Host syssla.felixarvidsson.se;
        proxy_set_header Authorization "Bearer ${SYSSLA_TOKEN}";
        proxy_set_header Cookie "";
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

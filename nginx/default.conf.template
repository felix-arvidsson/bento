server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy the secret Google Calendar iCal feeds so the URLs never reach the
    # browser. One /calendar-N.ics location per URL is generated at container
    # start from CALENDAR_ICS_URLS by nginx/30-feeds.sh.
    include /etc/nginx/feeds.conf;

    # Proxy to Syssla; the token is added here and never reaches the browser.
    # Only lists/tasks/scopes are exposed (no auth, google or friends), and the
    # X-Bento header forces a CORS preflight so other sites can't call it.
    location ~ ^/syssla/api/(lists|tasks|scopes)(/|$) {
        if ($http_x_bento != "1") { return 403; }
        rewrite ^/syssla(/api/.*)$ $1 break;
        proxy_pass https://syssla.felixarvidsson.se;
        proxy_ssl_server_name on;
        proxy_set_header Host syssla.felixarvidsson.se;
        proxy_set_header Authorization "Bearer ${SYSSLA_TOKEN}";
        proxy_set_header Cookie "";
        add_header Cache-Control "no-store";
    }

    # Syssla's own free-text parser (due:/prio:/list:/recur:), kept in sync with the server
    location = /syssla/parser.js {
        proxy_pass https://syssla.felixarvidsson.se/static/parser.js;
        proxy_ssl_server_name on;
        proxy_set_header Host syssla.felixarvidsson.se;
    }

    # Always revalidate the app itself so a rebuild is picked up on reload;
    # without this Chrome heuristically serves stale JS after deploys.
    location ~* \.(html|js|css)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
